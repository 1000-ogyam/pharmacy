<IfModule mod_rewrite.c>
    RewriteEngine On

    # Old XAMPP bookmarks only: /pharmacy/public/... → /pharmacy/...
    RewriteCond %{THE_REQUEST} \s/+pharmacy/public/ [NC]
    RewriteRule ^public(?:/(.*))?$ /pharmacy/$1 [R=301,L,QSA]

    # Already rewritten into public/ — stop here so LiteSpeed cannot loop.
    RewriteRule ^public/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php
